let map,markers=[],infoWindow;
function initMap(){map=new google.maps.Map(document.getElementById("map"),{center:{lat:35.5,lng:-79},zoom:7});infoWindow=new google.maps.InfoWindow({maxWidth:180});}
function clearMarkers(){markers.forEach(m=>m.setMap(null));markers=[];}
function dist(a,b,c,d){const R=3958.8,x=(c-a)*Math.PI/180,y=(d-b)*Math.PI/180,q=Math.sin(x/2)**2+Math.cos(a*Math.PI/180)*Math.cos(c*Math.PI/180)*Math.sin(y/2)**2;return R*2*Math.atan2(Math.sqrt(q),Math.sqrt(1-q));}
function drawMap(u,s){if(!map){setTimeout(()=>drawMap(u,s),120);return;}clearMarkers();map.setCenter(u);map.setZoom(10);markers.push(new google.maps.Marker({position:u,map,icon:"https://maps.google.com/mapfiles/ms/icons/blue-dot.png"}));s.slice(0,5).forEach(c=>{const m=new google.maps.Marker({position:{lat:c.lat,lng:c.lng},map,icon:"https://maps.google.com/mapfiles/ms/icons/red-dot.png"});m.addListener("mouseover",()=>{infoWindow.setContent('<div style="font-size:13px;line-height:1.25;padding:2px 4px;"><strong>'+c.n+'</strong><br>'+c.c+'</div>');infoWindow.open(map,m);});m.addListener("mouseout",()=>infoWindow.close());markers.push(m);});}
function render(s,z){const box=document.getElementById("results");box.innerHTML="";s.slice(0,5).forEach(c=>{const div=document.createElement("div");div.className="club-card";div.innerHTML='<img class="club-logo" src="'+c.l+'"><div><strong>'+c.n+'</strong><br>'+c.distance.toFixed(1)+' miles from '+z+'<br>'+(c.w?'Website: <a href="'+c.w+'" target="_blank">'+c.w+'</a><br>':'')+(c.e?'Email: <a href="mailto:'+c.e+'">'+c.e+'</a>':'')+'</div>';box.appendChild(div);});}
document.getElementById("zip-form").addEventListener("submit",async(e)=>{e.preventDefault();const z=document.getElementById("zip-input").value.trim(),msg=document.getElementById("status");msg.textContent="";if(!/^\d{5}$/.test(z)){msg.textContent="Enter a valid ZIP.";return;}try{const r=await fetch("https://api.zippopotam.us/us/"+z);if(!r.ok)throw 0;const d=await r.json(),u={lat:parseFloat(d.places[0].latitude),lng:parseFloat(d.places[0].longitude)},s=clubs.map(c=>({...c,distance:dist(u.lat,u.lng,c.lat,c.lng)})).sort((a,b)=>a.distance-b.distance);render(s,z);drawMap(u,s);if(window.dataLayer)window.dataLayer.push({event:"zip_search",search_zip:z,nearest_club_name:s[0]?.n||"",nearest_club_distance_miles:s[0]?.distance.toFixed(1)||""});}catch{msg.textContent="Error processing ZIP.";}});
</script>
